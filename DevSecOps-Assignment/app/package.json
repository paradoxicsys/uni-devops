{
  "name": "devsecops-demo",
  "version": "1.0.0",
  "description": "Small Express API used for the Session 17 DevSecOps pipeline",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "node --check src/app.js && node --check src/server.js",
    "test": "node --test test/*.test.js",
    "test:report": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  }
}
